<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/video">

        <PreferenceCategory
            app:key="@string/video_settings_key"
            app:title="@string/settings">

            <ListPreference
                app:key="@string/stream_orientation_key"
                app:title="@string/stream_orientation_title"
                app:summary="@string/stream_orientation_summary"
                app:defaultValue="@string/stream_orientation_value_auto"
                app:entryValues="@array/stream_orientation_values"
                app:entries="@array/stream_orientation_entries"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                app:defaultValue="@string/default_video_encoder"
                app:key="@string/video_encoder_key"
                app:title="@string/video_encoder"
                app:useSimpleSummaryProvider="true" />

            <SwitchPreference
                app:defaultValue="true"
                app:key="@string/video_resolution_hardware_filter_key"
                app:title="@string/video_resolution_hardware_filter_title"
                app:summary="@string/video_resolution_hardware_filter_summary" />

            <ListPreference
                app:defaultValue="@string/default_video_resolution"
                app:key="@string/video_resolution_key"
                app:title="@string/video_resolution"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                app:defaultValue="@string/default_fps"
                app:entries="@array/FpsEntries"
                app:entryValues="@array/FpsEntries"
                app:key="@string/camera_fps_key"
                app:title="@string/camera_fps"
                app:useSimpleSummaryProvider="true" />

            <SwitchPreference
                app:defaultValue="true"
                app:key="@string/match_fps_key"
                app:title="@string/match_fps_title"
                app:disableDependentsState="true" />

            <Preference
                app:key="@string/video_fps_note_key"
                app:summary="@string/video_fps_note_summary"
                app:selectable="false" />

            <ListPreference
                app:dependency="@string/match_fps_key"
                app:defaultValue="@string/default_fps"
                app:entries="@array/FpsEntries"
                app:entryValues="@array/FpsEntries"
                app:key="@string/video_fps_key"
                app:title="@string/video_fps"
                app:useSimpleSummaryProvider="true" />

            <SeekBarPreference
                android:max="10000"
                app:defaultValue="@string/default_video_bitrate"
                app:key="@string/video_bitrate_key"
                app:min="500"
                app:showSeekBarValue="true"
                app:title="@string/video_bitrate"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                app:key="@string/video_profile_key"
                app:title="@string/video_profile"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                app:key="@string/video_level_key"
                app:title="@string/video_level"
                app:useSimpleSummaryProvider="true" />
        </PreferenceCategory>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/endpoint">
        <ListPreference
            app:defaultValue="2"
            app:key="@string/endpoint_type_key"
            app:title="@string/endpoint_type"
            app:useSimpleSummaryProvider="true" />

        <PreferenceCategory
            app:key="@string/srt_server_key"
            app:title="@string/srt_server">

            <EditTextPreference
                app:defaultValue="@string/default_srt_server_url"
                app:key="@string/srt_server_ip_key"
                app:title="@string/server_ip"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_srt_server_port"
                app:key="@string/srt_server_port_key"
                app:title="@string/server_port"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_srt_server_stream_id"
                app:key="@string/srt_server_stream_id_key"
                app:title="@string/srt_server_stream_id"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_srt_server_latency"
                app:key="@string/srt_server_latency_key"
                app:title="@string/srt_server_latency"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_srt_server_passphrase"
                app:key="@string/srt_server_passphrase_key"
                app:title="@string/srt_server_passphrase"
                app:useSimpleSummaryProvider="true" />


        </PreferenceCategory>

        <PreferenceCategory
            app:key="@string/rtmp_server_key"
            app:title="@string/rtmp_server">

            <EditTextPreference
                app:defaultValue="@string/default_rtmp_url"
                app:key="@string/rtmp_server_url_key"
                app:title="@string/server_url"
                app:useSimpleSummaryProvider="true" />

        </PreferenceCategory>

        <PreferenceCategory
            app:key="@string/srtla_key"
            app:title="@string/srtla_settings">

            <EditTextPreference
                app:defaultValue="@string/default_srtla_receiver_host"
                app:key="@string/srtla_receiver_host_key"
                app:title="@string/srtla_receiver_host"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_srtla_receiver_port"
                app:key="@string/srtla_receiver_port_key"
                app:title="@string/srtla_receiver_port"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_srtla_listen_port"
                app:key="@string/srtla_listen_port_key"
                app:title="@string/srtla_listen_port"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:key="@string/srtla_stream_id_key"
                app:title="@string/srtla_stream_id"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_srtla_latency"
                app:key="@string/srtla_latency_key"
                app:title="@string/srtla_latency"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:key="@string/srtla_passphrase_key"
                app:title="@string/srtla_passphrase"
                app:useSimpleSummaryProvider="true" />

            <!-- Moblink relay bonding settings -->
            <SwitchPreference
                android:defaultValue="false"
                app:key="@string/moblink_enabled_key"
                app:summary="@string/moblink_summary"
                app:title="@string/moblink_enabled" />

            <EditTextPreference
                app:defaultValue="@string/default_moblink_password"
                app:key="@string/moblink_password_key"
                app:title="@string/moblink_password"
                app:dialogMessage="@string/moblink_password_hint"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="@string/default_moblink_port"
                app:key="@string/moblink_port_key"
                app:title="@string/moblink_port"
                app:useSimpleSummaryProvider="true" />

            <Preference
                app:key="@string/moblink_bitrate_note_key"
                app:summary="@string/moblink_bitrate_note"
                app:selectable="false" />

        </PreferenceCategory>

        <PreferenceCategory
            app:key="@string/bitrate_regulation_key"
            app:title="@string/bitrate_regulation">

            <SwitchPreference
                android:defaultValue="true"
                app:key="@string/srt_server_enable_bitrate_regulation_key"
                app:title="@string/srt_server_enable_bitrate_regulation" />

            <SeekBarPreference
                android:max="10000"
                app:defaultValue="5000"
                app:key="@string/srt_server_video_target_bitrate_key"
                app:min="500"
                app:showSeekBarValue="true"
                app:title="@string/srt_server_video_target_bitrate"
                app:useSimpleSummaryProvider="true" />

            <SeekBarPreference
                android:max="10000"
                app:defaultValue="300"
                app:key="@string/srt_server_video_min_bitrate_key"
                app:min="100"
                app:showSeekBarValue="true"
                app:title="@string/srt_server_video_min_bitrate"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                app:defaultValue="@string/srt_server_moblin_regulator_mode_value_belabox"
                app:key="@string/srt_server_moblin_regulator_mode_key"
                app:title="@string/srt_server_moblin_regulator_mode"
                app:entries='@array/moblin_regulator_mode_entries'
                app:entryValues='@array/moblin_regulator_mode_values'
                app:useSimpleSummaryProvider="true" />

            <SwitchPreference
                android:defaultValue="false"
                app:key="@string/rtmp_server_enable_bitrate_regulation_key"
                app:title="@string/rtmp_server_enable_bitrate_regulation" />

            <SeekBarPreference
                android:max="10000"
                app:defaultValue="5000"
                app:key="@string/rtmp_server_video_target_bitrate_key"
                app:min="500"
                app:showSeekBarValue="true"
                app:title="@string/rtmp_server_video_target_bitrate"
                app:useSimpleSummaryProvider="true" />

            <SeekBarPreference
                android:max="10000"
                app:defaultValue="300"
                app:key="@string/rtmp_server_video_min_bitrate_key"
                app:min="100"
                app:showSeekBarValue="true"
                app:title="@string/rtmp_server_video_min_bitrate"
                app:useSimpleSummaryProvider="true" />

        </PreferenceCategory>

        <PreferenceCategory
            app:key="@string/file_endpoint_key"
            app:title="@string/file">

            <EditTextPreference
                app:defaultValue="@string/default_file_name"
                app:key="@string/file_name_key"
                app:title="@string/file_name"
                app:useSimpleSummaryProvider="true" />

        </PreferenceCategory>
    </PreferenceCategory>
</PreferenceScreen>