<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewmodel"
            type="com.dimadesu.lifestreamer.ui.main.PreviewViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E1E1E"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:keepScreenOn="true">

        <io.github.thibaultbee.streampack.ui.views.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:enableZoomOnPinch="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:position="center"
            app:scaleMode="fit" />

        <!-- RTMP status message (centered) -->
        <TextView
            android:id="@+id/rtmpStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="#80000000"
            android:text='@{viewmodel.rtmpStatusLiveData}'
            app:goneUnless='@{viewmodel.rtmpStatusLiveData != null}'
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Reconnection status message (positioned at 1/4 from top) -->
        <TextView
            android:id="@+id/reconnectionStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="#80000000"
            android:text='@{viewmodel.reconnectionStatusLiveData}'
            app:goneUnless='@{viewmodel.reconnectionStatusLiveData != null}'
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.25" />



        <!-- Top-right controls (stream stats, audio source indicator, VU meter) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/topRightControlsComposeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ScrollView
            android:id="@+id/srtlaStatsScrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#80000000"
            android:elevation="10dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintVertical_bias="1.0"
            app:layout_constraintTop_toBottomOf="@+id/topRightControlsComposeView"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cameraControlsComposeView">

            <com.dimadesu.bondbunny.SrtlaStatsView
                android:id="@+id/srtlaStatsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

        </ScrollView>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/cameraDrawerComposeView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/rtmpDrawerComposeView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/audioSourceDrawerComposeView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/videoSettingsDrawerComposeView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/endpointSettingsDrawerComposeView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/cameraSlidersComposeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/cameraControlsComposeView"
            app:layout_constraintEnd_toStartOf="@+id/cameraControlsComposeView"
            app:layout_constraintTop_toTopOf="@+id/cameraControlsComposeView" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/cameraControlsComposeView"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topRightControlsComposeView"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>